{
  "name": "ds-code",
  "version": "0.1.0",
  "description": "The code tools as one MCP server for any agent: definitions, references, callers, callees, file outlines, a repo overview and change impact, answered by TypeScript's and Pyright's language servers.",
  "type": "module",
  "bin": {
    "ds-code": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "pyright": "1.1.414",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
